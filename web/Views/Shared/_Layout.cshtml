<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SteamHeatmap</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <main class="page">
        @RenderBody()
    </main>

    @* ADR-015: the Valve non-affiliation notice lives here, where such notices
       conventionally sit. Always visible, per #6. *@
    <footer class="page footer">
        <p class="footer-disclosure">
            SteamHeatmap is not affiliated with or endorsed by Valve. Data powered by
            <a href="https://store.steampowered.com/" target="_blank" rel="noopener">Steam</a>.
        </p>
        <p class="footer-copyright">&copy; 2026 SteamHeatmap</p>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
